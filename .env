# LogoKit publishable key — merchant logos on the Activity screen.
# EXPO_PUBLIC_* values are inlined into the JS bundle by Metro on every platform,
# which is why the token lives here rather than only in app.json's `extra`
# (`extra` is not inlined into the native bundle).
#
# Publishable keys are designed to ship inside clients. A LogoKit SECRET key
# (sk_…, required by the Brand Data API) must never be put in this file.
EXPO_PUBLIC_LOGOKIT_TOKEN=pk_fre363b644541b4396e087
