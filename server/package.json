{
  "name": "paisa-server",
  "version": "1.0.0",
  "private": true,
  "description": "Paisa API \u2014 auth, accounts, categories and transactions.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "test:api": "tsx src/scripts/apitest.ts",
    "test:step": "tsx src/scripts/steptest.ts",
    "test:ai": "tsx src/scripts/aitest.ts"
  },
  "dependencies": {
    "@types/luxon": "^3.7.5",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.19.1",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.0",
    "pino-pretty": "^13.1.2",
