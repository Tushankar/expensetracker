# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Mongo connection string, including the database name.
MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/paisa?retryWrites=true&w=majority

# Two independent secrets. Rotating the refresh secret logs everyone out;
# rotating the access secret only invalidates in-flight access tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list, or * to allow any origin (dev only).
CORS_ORIGINS=*

# Requests per window, per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Groq, for the AI assistant. Server-only — never an EXPO_PUBLIC_ value.
# Leave it blank and every AI endpoint still answers, using the deterministic
# summaries the analytics service produces.
GROQ_API_KEY=gsk_your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=15000

AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# The model that reads receipt photographs. Vision is a separate capability from
# prose and not every Groq account has it — check GET /models on your own account
# rather than trusting a list. Leave GROQ_API_KEY blank and receipt reading is
# simply unavailable; nothing else changes.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_TIMEOUT_MS=40000

# Cloudinary, for receipt images. All three or none.
#
# The secret signs upload permissions and verifies what came back; it never
# leaves the server and is never an EXPO_PUBLIC_ value. Find all three on the
# Cloudinary dashboard under Settings -> API Keys.
#
# Without them GET /receipts/status reports storage: false, the app hides the
# camera button and explains why, and every other feature is unaffected.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=paisa/receipts

RECEIPT_MAX_BYTES=10485760
RECEIPT_RATE_LIMIT_WINDOW_MS=60000
RECEIPT_RATE_LIMIT_MAX=30

RECURRING_ENABLED=true
RECURRING_INTERVAL_MS=60000

LOG_LEVEL=info
