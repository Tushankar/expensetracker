# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Mongo connection string, including the database name.
MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/paisa?retryWrites=true&w=majority

# Two independent secrets. Rotating the refresh secret logs everyone out;
# rotating the access secret only invalidates in-flight access tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list, or * to allow any origin (dev only).
CORS_ORIGINS=*

# Requests per window, per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

LOG_LEVEL=info
